<Window x:Class="YtecStickyNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YtecStickyNote.Controls"
        Title="罫彩"
        Width="520" Height="620"
        MinWidth="360" MinHeight="400"
        Icon="Assets/app-icon.ico"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FFF9CD"
        FontFamily="{StaticResource AppFont}"
        Foreground="#263238"
        Language="ja-JP"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="7"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#4A463C" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleButtonBorder" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleButtonBorder" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormatButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="31" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1E2F3A40" />
            <Setter Property="Background" Value="#72FFFFFF" />
            <Setter Property="Foreground" Value="#2E3438" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFDF7D7" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#806E5E2D" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF7E7B4" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#806E5E2D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse x:Name="ThemeCircle"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness}" />
                            <Ellipse x:Name="SelectedRing" Margin="-3" Stroke="#8A55452C" StrokeThickness="2" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeCircle" Property="Stroke" Value="#8055452C" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectedRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormatActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="31" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1E2F3A40" />
            <Setter Property="Background" Value="#72FFFFFF" />
            <Setter Property="Foreground" Value="#2E3438" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFDF7D7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="BorderBrush" Value="#26384046" />
            <Setter Property="Background" Value="#B8FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
    </Window.Resources>

    <Border x:Name="ShellBorder" BorderBrush="#386E5E2D" BorderThickness="1" Background="#FFF9CD" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="#FBEFA6" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="6" Background="#88FFFFFF" Margin="0,0,8,0">
                        <Image Source="Assets/app-icon.png" Width="18" Height="18" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="罫彩" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="#514A39" />
                    <TextBlock x:Name="SaveStatusText" Text="準備中…" FontSize="11" Margin="10,1,0,0" VerticalAlignment="Center" Foreground="#796F58" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,5,0">
                    <ToggleButton x:Name="TopmostButton" Width="38" Height="32" Margin="2,6" Background="Transparent" BorderThickness="0"
                                  ToolTip="常に手前に表示" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"
                                  Checked="TopmostButton_Changed" Unchecked="TopmostButton_Changed">
                        <TextBlock Text="◇" FontSize="18" />
                    </ToggleButton>
                    <Button Style="{StaticResource TitleButtonStyle}" Content="—" ToolTip="最小化" Click="MinimizeButton_Click" />
                    <Button Style="{StaticResource TitleButtonStyle}" Content="×" ToolTip="閉じる" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <Border x:Name="FormattingBar" Grid.Row="1" Background="#BFFFFFFF" BorderBrush="#183C3C36" BorderThickness="0,0,0,1" Padding="8,5">
                <WrapPanel VerticalAlignment="Center">
                    <ToggleButton x:Name="BoldButton" Style="{StaticResource FormatButtonStyle}" ToolTip="太字 (Ctrl+B)" Click="BoldButton_Click">
                        <TextBlock Text="B" FontWeight="Bold" />
                    </ToggleButton>
                    <ToggleButton x:Name="ItalicButton" Style="{StaticResource FormatButtonStyle}" ToolTip="斜体 (Ctrl+I)" Click="ItalicButton_Click">
                        <TextBlock Text="I" FontStyle="Italic" />
                    </ToggleButton>
                    <ToggleButton x:Name="UnderlineButton" Style="{StaticResource FormatButtonStyle}" ToolTip="下線 (Ctrl+U)" Click="UnderlineButton_Click">
                        <TextBlock Text="U" TextDecorations="Underline" />
                    </ToggleButton>
                    <ToggleButton x:Name="StrikeButton" Style="{StaticResource FormatButtonStyle}" ToolTip="取り消し線" Click="StrikeButton_Click">
                        <TextBlock Text="S" TextDecorations="Strikethrough" />
                    </ToggleButton>
                    <ToggleButton x:Name="CenterAlignButton" Style="{StaticResource FormatButtonStyle}" ToolTip="中央揃え (Ctrl+E)" Click="CenterAlignButton_Click">
                        <StackPanel>
                            <Border Width="17" Height="1" Margin="0,1.5" Background="#A02E3438" />
                            <Border Width="11" Height="1" Margin="0,1.5" Background="#A02E3438" />
                            <Border Width="17" Height="1" Margin="0,1.5" Background="#A02E3438" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="BulletButton" Style="{StaticResource FormatButtonStyle}" IsThreeState="True" ToolTip="箇条書き（Shift+Enterで項目内改行）" Click="BulletButton_Click">
                        <TextBlock Text="•≡" FontSize="13" />
                    </ToggleButton>

                    <Button x:Name="UndoButton" Style="{StaticResource FormatActionButtonStyle}" Content="↶" ToolTip="元に戻す (Ctrl+Z)" Click="UndoButton_Click" IsEnabled="False" />
                    <Button x:Name="RedoButton" Style="{StaticResource FormatActionButtonStyle}" Content="↷" ToolTip="やり直す (Ctrl+Y)" Click="RedoButton_Click" IsEnabled="False" />
                    <Button x:Name="ClearFormattingButton" Style="{StaticResource FormatActionButtonStyle}" Content="T×" FontSize="12" ToolTip="文字装飾をクリア" Click="ClearFormattingButton_Click" />
                    <Button x:Name="SearchButton" Style="{StaticResource FormatActionButtonStyle}" Content="⌕" ToolTip="検索 (Ctrl+F)" Click="SearchButton_Click" />

                    <Border Width="1" Height="24" Margin="4,4" Background="#283C3C36" />

                    <ComboBox x:Name="FontFamilyCombo"
                              Width="126"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="DisplayName"
                              StaysOpenOnEdit="True"
                              MaxDropDownHeight="360"
                              ToolTip="フォント（★はよく使うフォント）"
                              SelectionChanged="FontFamilyCombo_SelectionChanged"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" FontFamily="{Binding FamilyName}" MinWidth="210" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Name="FontSizeCombo" Width="56" SelectedIndex="2" ToolTip="文字サイズ" SelectionChanged="FontSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="14" Tag="14" />
                        <ComboBoxItem Content="16" Tag="16" />
                        <ComboBoxItem Content="18" Tag="18" />
                        <ComboBoxItem Content="20" Tag="20" />
                        <ComboBoxItem Content="22" Tag="22" />
                    </ComboBox>
                    <ComboBox x:Name="FontColorCombo" Width="72" SelectedIndex="0" ToolTip="文字色" SelectionChanged="FontColorCombo_SelectionChanged">
                        <ComboBoxItem Content="墨色" Tag="#2F3437" Foreground="#2F3437" />
                        <ComboBoxItem Content="紺色" Tag="#264A67" Foreground="#264A67" />
                        <ComboBoxItem Content="赤色" Tag="#A33E3E" Foreground="#A33E3E" />
                        <ComboBoxItem Content="緑色" Tag="#356B4C" Foreground="#356B4C" />
                        <ComboBoxItem Content="紫色" Tag="#684A79" Foreground="#684A79" />
                        <ComboBoxItem Content="茶色" Tag="#704B35" Foreground="#704B35" />
                        <ComboBoxItem Content="橙色" Tag="#B85C27" Foreground="#B85C27" />
                        <ComboBoxItem Content="青緑" Tag="#24756E" Foreground="#24756E" />
                        <ComboBoxItem Content="桃色" Tag="#B5426A" Foreground="#B5426A" />
                        <ComboBoxItem Content="灰色" Tag="#5F686E" Foreground="#5F686E" />
                    </ComboBox>
                </WrapPanel>
            </Border>

            <Border x:Name="SearchPanel" Grid.Row="2" Visibility="Collapsed" Background="#A8FFFFFF" BorderBrush="#183C3C36" BorderThickness="0,0,0,1" Padding="8,4">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="検索" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#5E5B54" />
                    <TextBox x:Name="SearchBox" Width="148" Height="28" Padding="5,2" VerticalContentAlignment="Center"
                             ToolTip="現在のメモを検索" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <Button x:Name="SearchPreviousButton" Style="{StaticResource FormatActionButtonStyle}" Content="‹" ToolTip="前を検索 (Shift+Enter / Shift+F3)" Click="SearchPreviousButton_Click" />
                    <Button x:Name="SearchNextButton" Style="{StaticResource FormatActionButtonStyle}" Content="›" ToolTip="次を検索 (Enter / F3)" Click="SearchNextButton_Click" />
                    <TextBlock x:Name="SearchResultText" Text="0 / 0" MinWidth="42" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="#5E5B54" />
                    <Button Style="{StaticResource FormatActionButtonStyle}" Content="×" ToolTip="検索を閉じる (Esc)" Click="CloseSearchButton_Click" />
                </WrapPanel>
            </Border>

            <Grid Grid.Row="3" ClipToBounds="True">
                <controls:NotePaper x:Name="Paper" LineHeight="30" TopPadding="10" RuleLift="0" IsHitTestVisible="False" />
                <RichTextBox x:Name="Editor"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#2F3437"
                             CaretBrush="#2F3437"
                             FontFamily="Yu Gothic UI"
                             FontSize="18"
                             AcceptsReturn="True"
                             AcceptsTab="False"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             SpellCheck.IsEnabled="True"
                             TextChanged="Editor_TextChanged"
                             SelectionChanged="Editor_SelectionChanged"
                             PreviewKeyDown="Editor_PreviewKeyDown">
                    <RichTextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="UndoMenuItem" Header="元に戻す" InputGestureText="Ctrl+Z" Click="UndoButton_Click" IsEnabled="False" />
                            <MenuItem x:Name="RedoMenuItem" Header="やり直す" InputGestureText="Ctrl+Y" Click="RedoButton_Click" IsEnabled="False" />
                            <Separator />
                            <MenuItem Header="切り取り" Command="ApplicationCommands.Cut" />
                            <MenuItem Header="コピー" Command="ApplicationCommands.Copy" />
                            <MenuItem Header="貼り付け" Command="ApplicationCommands.Paste" />
                            <MenuItem x:Name="PastePlainTextMenuItem" Header="テキストのみ貼り付け" InputGestureText="Ctrl+Shift+V" Click="PastePlainTextMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="すべて選択" Command="ApplicationCommands.SelectAll" />
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                    <FlowDocument PagePadding="64,10,22,24"
                                  ColumnWidth="1000"
                                  LineHeight="30"
                                  LineStackingStrategy="BlockLineHeight">
                        <Paragraph Margin="0" />
                    </FlowDocument>
                </RichTextBox>
                <TextBlock x:Name="PlaceholderText"
                           Text="ここにメモを書きます…"
                           Margin="64,14,22,0"
                           FontSize="18"
                           Foreground="#77736A"
                           Opacity="0.65"
                           IsHitTestVisible="False"
                           VerticalAlignment="Top" />
            </Grid>

            <Border x:Name="SettingsBar" Grid.Row="4" Background="#CFFFFFFF" BorderBrush="#183C3C36" BorderThickness="0,1,0,0" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="背景" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#5E5B54" />
                        <ToggleButton x:Name="ThemeLemon" Tag="lemon" Background="#FFF9CD" ToolTip="レモン" Style="{StaticResource ThemeButtonStyle}" Click="ThemeButton_Click" />
                        <ToggleButton x:Name="ThemeSakura" Tag="sakura" Background="#FFEFF4" ToolTip="さくら" Style="{StaticResource ThemeButtonStyle}" Click="ThemeButton_Click" />
                        <ToggleButton x:Name="ThemeMint" Tag="mint" Background="#EEF9ED" ToolTip="ミント" Style="{StaticResource ThemeButtonStyle}" Click="ThemeButton_Click" />
                        <ToggleButton x:Name="ThemeSky" Tag="sky" Background="#EDF7FF" ToolTip="スカイ" Style="{StaticResource ThemeButtonStyle}" Click="ThemeButton_Click" />
                        <ToggleButton x:Name="ThemeIvory" Tag="ivory" Background="#FAF5EA" ToolTip="アイボリー" Style="{StaticResource ThemeButtonStyle}" Click="ThemeButton_Click" />
                        <ToggleButton x:Name="ThemeLavender" Tag="lavender" Background="#F5F0FF" ToolTip="ラベンダー" Style="{StaticResource ThemeButtonStyle}" Click="ThemeButton_Click" />
                        <ToggleButton x:Name="ThemePeach" Tag="peach" Background="#FFF0E6" ToolTip="ピーチ" Style="{StaticResource ThemeButtonStyle}" Click="ThemeButton_Click" />
                        <ToggleButton x:Name="ThemeAqua" Tag="aqua" Background="#EAF9F8" ToolTip="アクア" Style="{StaticResource ThemeButtonStyle}" Click="ThemeButton_Click" />
                        <ToggleButton x:Name="ThemeGray" Tag="gray" Background="#F3F4F5" ToolTip="グレー" Style="{StaticResource ThemeButtonStyle}" Click="ThemeButton_Click" />
                        <ToggleButton x:Name="ThemeMocha" Tag="mocha" Background="#F4ECE4" ToolTip="モカ" Style="{StaticResource ThemeButtonStyle}" Click="ThemeButton_Click" />
                    </WrapPanel>
                    <WrapPanel Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ページ" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#5E5B54" />
                        <Button x:Name="PreviousPageButton" Style="{StaticResource FormatActionButtonStyle}" Content="‹" ToolTip="前のページ" Click="PreviousPageButton_Click" IsEnabled="False" />
                        <TextBlock x:Name="PageIndicatorText" Text="1 / 1" MinWidth="42" Margin="5,0" FontSize="11" VerticalAlignment="Center" Foreground="#5E5B54" TextAlignment="Center" />
                        <Button x:Name="NextPageButton" Style="{StaticResource FormatActionButtonStyle}" Content="›" ToolTip="次のページ" Click="NextPageButton_Click" IsEnabled="False" />
                        <Button x:Name="AddPageButton" Style="{StaticResource FormatActionButtonStyle}" Content="＋" FontSize="14" ToolTip="現在の次にページを追加" Click="AddPageButton_Click" />
                        <Button x:Name="DeletePageButton" Style="{StaticResource FormatActionButtonStyle}" Content="−" FontSize="15" ToolTip="現在のページを削除" Click="DeletePageButton_Click" IsEnabled="False" />
                    </WrapPanel>
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="AutoStartCheck" Content="自動起動" VerticalAlignment="Center"
                                  ToolTip="操作した時だけWindowsの自動起動設定を変更します" Cursor="Hand"
                                  Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed" />
                        <Button Grid.Column="1" Width="30" Height="28" Content="↗" ToolTip="保存場所を開く" Click="OpenDataFolderButton_Click"
                                Background="#80FFFFFF" BorderBrush="#263C3C36" BorderThickness="1" Cursor="Hand" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
